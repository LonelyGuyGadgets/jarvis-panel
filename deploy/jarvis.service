[Unit]
Description=Jarvis lab control panel
After=network-online.target plexmediaserver.service
Wants=network-online.target

[Service]
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/jarvis
ExecStart=/home/YOUR_USER/jarvis/.venv/bin/python run.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
